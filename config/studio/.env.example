# Studio Graphs Environment Variables
# For demonstration graphs: parallelization, sub_graphs, map_reduce, research_assistant

# OpenAI API Configuration
# Required for all studio graphs using OpenAI models
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Tavily API Configuration
# Required for parallelization and research_assistant graphs
# Get your API key from: https://tavily.com
TAVILY_API_KEY=tvly-xxxx

# LangSmith Configuration (Optional but Recommended)
# Used for tracing and debugging graph executions
# Get your API key from: https://smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langgraph-studio-graphs
