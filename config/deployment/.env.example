# Deployment Graphs Environment Variables
# For production graph: task_maistro

# OpenAI API Configuration
# Required for task_maistro graph using OpenAI models
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# LangSmith Configuration (Optional but Recommended)
# Used for tracing and monitoring production graph executions
# Get your API key from: https://smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langgraph-deployment-graphs

# Task Maistro Configuration
# Optional: Configure memory persistence and other settings
# SQLITE_DB_PATH=./task_maistro.db
