# OpenAI API Configuration
# Required for all LangChain/LangGraph operations using OpenAI models
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Tavily API Configuration
# Required for web search functionality in research and parallelization graphs
# Get your API key from: https://tavily.com
TAVILY_API_KEY=tvly-xxxx

# LangSmith Configuration (Optional but Recommended)
# Used for tracing, debugging, and monitoring LangGraph executions
# Get your API key from: https://smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langgraph-project

# LangGraph Configuration
# Optional: Set custom host/port for LangGraph Studio
# LANGGRAPH_HOST=localhost
# LANGGRAPH_PORT=8123